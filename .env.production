# ================================================
# IT 자산 인벤토리 시스템 - 프로덕션 환경 설정
# ================================================
# 이 파일은 프로덕션 환경 배포 시 사용하는 환경 변수 템플릿입니다.
# 실제 배포 시:
#   1. 이 파일을 복사하여 backend/.env 생성: cp .env.production backend/.env
#   2. 모든 플레이스홀더 값을 실제 값으로 변경
#   3. 민감한 정보가 포함되어 있으므로 Git에 커밋하지 않도록 주의
# ================================================

# ============================================
# 데이터베이스 설정
# ============================================
# 프로덕션: docker-compose.production.yml 사용 시 'database' 호스트명 사용
# 개발: docker-compose.yml 사용 시 'localhost' 사용
DB_HOST=database
DB_NAME=inventory_db
DB_USER=inventory_user
# 중요: 반드시 강력한 비밀번호로 변경하세요!
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_PORT=5432

# ============================================
# JWT 인증 설정
# ============================================
# 중요: 무작위 문자열(최소 32자 이상)로 변경하세요!
# 생성 방법: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_KEY_MIN_32_CHARS

# ============================================
# 서버 설정
# ============================================
# 프로덕션 환경에서는 반드시 production으로 설정
PORT=3000
NODE_ENV=production

# ============================================
# LDAP 인증 설정
# ============================================
# LDAP 인증 활성화 여부 (true/false)
# true: LDAP 서버를 통한 인증 (권장: 기업 환경)
# false: 로컬 데이터베이스 인증만 사용
LDAP_ENABLED=true

# LDAP 서버 주소 (기존 서버 주소 유지)
# 형식: ldap://서버IP:포트 또는 ldaps://서버IP:포트 (SSL)
LDAP_SERVER=ldap://172.30.1.97:389

# LDAP 바인드 계정 (읽기 전용 서비스 계정 사용 권장)
# 형식: cn=계정명,dc=도메인,dc=컴
LDAP_BIND_DN=cn=admin,dc=roboetech,dc=com
# 중요: LDAP 바인드 계정의 비밀번호
LDAP_BIND_PASSWORD=CHANGE_ME_LDAP_BIND_PASSWORD

# LDAP 사용자 검색 기준 DN
# 형식: ou=조직단위,dc=도메인,dc=컴
LDAP_USER_BASE=ou=users,dc=roboetech,dc=com

# LDAP 그룹 검색 기준 DN
LDAP_GROUP_BASE=ou=groups,dc=roboetech,dc=com

# LDAP 사용자 검색 필터
# %s는 사용자가 입력한 아이디로 자동 치환됩니다
# 여러 속성을 OR 조건으로 검색: cn, uid, sAMAccountName, mail
LDAP_USER_FILTER=(|(cn=%s)(uid=%s)(sAMAccountName=%s)(mail=%s))

# LDAP 그룹 멤버십 필터
# %s는 사용자 DN으로 자동 치환됩니다
LDAP_GROUP_FILTER=(member=%s)

# LDAP 사용자 속성 매핑
# 사용자 전체 이름을 가져올 속성명
LDAP_USER_FULLNAME_ATTR=cn
# 사용자 이메일을 가져올 속성명
LDAP_USER_EMAIL_ATTR=mail

# ============================================
# Active Directory 환경 설정 예제 (참고용)
# ============================================
# AD 환경에서는 아래 설정을 참고하여 수정하세요:
#
# LDAP_SERVER=ldap://your-ad-server.domain.com:389
# LDAP_BIND_DN=CN=LDAP Service Account,OU=Service Accounts,DC=domain,DC=com
# LDAP_BIND_PASSWORD=your-service-account-password
# LDAP_USER_BASE=OU=Users,DC=domain,DC=com
# LDAP_GROUP_BASE=OU=Groups,DC=domain,DC=com
# LDAP_USER_FILTER=(|(cn=%s)(sAMAccountName=%s)(userPrincipalName=%s))
# LDAP_GROUP_FILTER=(member=%s)
# LDAP_USER_FULLNAME_ATTR=displayName
# LDAP_USER_EMAIL_ATTR=mail

# ============================================
# 모니터링 설정 (선택사항)
# ============================================
# Grafana 관리자 비밀번호 (모니터링 프로파일 사용 시)
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# ============================================
# 보안 권장사항
# ============================================
# 1. 모든 'CHANGE_ME_' 접두사가 붙은 값을 변경하세요
# 2. 비밀번호는 최소 16자 이상, 영문/숫자/특수문자 혼합 사용
# 3. JWT_SECRET은 무작위 문자열로 생성 (openssl rand -base64 48)
# 4. 프로덕션 서버에서 이 파일의 권한을 제한하세요: chmod 600 backend/.env
# 5. 이 파일을 Git에 커밋하지 마세요 (.gitignore에 추가)
# 6. 정기적으로 비밀번호를 변경하세요 (최소 90일마다)

# ============================================
# 배포 체크리스트
# ============================================
# [ ] DB_PASSWORD 변경 완료
# [ ] JWT_SECRET 변경 완료
# [ ] LDAP_BIND_PASSWORD 변경 완료
# [ ] LDAP_SERVER 주소 확인 완료
# [ ] LDAP 연결 테스트 완료
# [ ] NODE_ENV=production 확인
# [ ] 파일 권한 설정 완료 (chmod 600)
# [ ] 백업 설정 확인 완료
