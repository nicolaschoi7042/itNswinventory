# IT 자산 인벤토리 시스템 - 환경 변수 템플릿
# 서버 이전 시 이 파일을 참조하여 backend/.env 파일을 생성하세요

# ============================================================================
# 데이터베이스 설정
# ============================================================================
# ⚠️ 경고: 데이터베이스 복원 시 이 값들은 백업과 동일해야 합니다!
DB_HOST=localhost
DB_NAME=inventory_db
DB_USER=inventory_user
DB_PASSWORD=inventory_password_2024
DB_PORT=5432

# ============================================================================
# JWT 인증 설정
# ============================================================================
# ⚠️ 경고: 기존 JWT 토큰과 호환성을 위해 기존 값을 그대로 사용하세요
# 새로운 배포인 경우에만 새 시크릿 키를 생성하세요
JWT_SECRET=inventory-jwt-secret-key-2024

# ============================================================================
# 서버 설정
# ============================================================================
PORT=3001
NODE_ENV=production  # 개발: development, 운영: production

# 프론트엔드 URL (CORS 설정용)
# 🔧 수정 필요: 새 서버의 IP 주소 또는 도메인으로 변경
FRONTEND_URL=http://새서버IP:8080
# 예: FRONTEND_URL=http://192.168.1.100:8080

# ============================================================================
# LDAP 설정 (선택사항)
# ============================================================================
# LDAP 인증 사용 여부
LDAP_ENABLED=true  # true: LDAP 사용, false: 로컬 인증만 사용

# LDAP 서버 주소
# 🔧 수정 필요: 새 서버에서 접근 가능한 LDAP 서버 주소로 변경
LDAP_SERVER=ldap://LDAP서버IP:389
# 예: LDAP_SERVER=ldap://172.30.1.97:389

# LDAP 관리자 계정 (바인드 DN)
# ⚠️ 주의: 기존 설정과 동일하게 유지하세요
LDAP_BIND_DN=cn=admin,dc=roboetech,dc=com
LDAP_BIND_PASSWORD=admin

# LDAP 검색 베이스
# ⚠️ 주의: 기존 설정과 동일하게 유지하세요
LDAP_USER_BASE=ou=users,dc=roboetech,dc=com
LDAP_GROUP_BASE=ou=groups,dc=roboetech,dc=com

# LDAP 검색 필터
LDAP_USER_FILTER=(|(cn=%s)(uid=%s)(sAMAccountName=%s)(mail=%s))
LDAP_GROUP_FILTER=(member=%s)

# LDAP 속성 매핑
LDAP_USER_FULLNAME_ATTR=cn
LDAP_USER_EMAIL_ATTR=mail

# ============================================================================
# 선택적 설정
# ============================================================================
# 시간대 설정 (선택사항)
# TZ=Asia/Seoul

# 로그 레벨 (선택사항)
# LOG_LEVEL=info  # debug, info, warn, error

# API 속도 제한 (선택사항)
# RATE_LIMIT_WINDOW_MS=900000  # 15분
# RATE_LIMIT_MAX_REQUESTS=100  # 15분당 최대 100 요청

# ============================================================================
# 마이그레이션 체크리스트
# ============================================================================
#
# 서버 이전 시 확인할 항목:
#
# [ ] DB_PASSWORD가 백업과 동일한지 확인
# [ ] JWT_SECRET이 기존 값과 동일한지 확인 (기존 토큰 호환성)
# [ ] FRONTEND_URL을 새 서버 IP로 변경
# [ ] LDAP_SERVER를 새 네트워크에서 접근 가능한 주소로 변경
# [ ] LDAP_BIND_DN과 LDAP_BIND_PASSWORD가 올바른지 확인
# [ ] NODE_ENV를 적절히 설정 (개발/운영)
# [ ] 새 서버에서 LDAP 서버 접근 가능 여부 테스트:
#     docker exec it-inventory-api nc -zv LDAP서버IP 389
#
# ============================================================================
# 보안 권장사항
# ============================================================================
#
# 운영 환경에서는 다음 항목들을 강력한 값으로 변경하는 것을 권장합니다:
#
# 1. DB_PASSWORD: 최소 16자 이상의 강력한 비밀번호
# 2. JWT_SECRET: 최소 32자 이상의 무작위 문자열
# 3. LDAP_BIND_PASSWORD: 강력한 관리자 비밀번호
#
# 강력한 비밀번호 생성 예:
# openssl rand -base64 32
#
# ⚠️ 주의: .env 파일은 Git에 커밋하지 마세요!
#
# ============================================================================
